      "source": [
        "from tensorflow.keras.layers import GlobalAveragePooling2D\n",
        "\n",
        "# Add a custom classification head on top of the base model\n",
        "inputs = Input(shape=IMG_SHAPE)\n",
        "x = base_model(inputs, training=False) # The base model is run in inference mode to freeze batch normalization layers\n",
        "x = GlobalAveragePooling2D()(x) # Averages the spatial dimensions of the input\n",
        "x = Dropout(0.2)(x) # Add dropout for regularization\n",
        "outputs = Dense(1, activation='sigmoid')(x) # Output layer for binary classification\n",
        "\n",
        "model_transfer = Model(inputs, outputs)\n",
        "\n",
        "# Compile the model\n",
        "# Use a slightly lower learning rate for fine-tuning\n",
        "base_learning_rate = 0.0001\n",
        "model_transfer.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=base_learning_rate),\n",
        "                       loss='binary_crossentropy',\n",
        "                       metrics=['accuracy'])"

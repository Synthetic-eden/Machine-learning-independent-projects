        "# Ensure target directories exist.\n",
        "# The 'test_images_subdir' might contain images from a previous run, so we'll only ensure 'unknown_class_dir' exists.\n",
        "os.makedirs(unknown_class_dir, exist_ok=True)\n",
        "\n",
        "# First, clean up any original image files still directly in test_dir from previous runs\n",
        "# (though the last `ls` output indicated test_dir was clean)\n",
        "for filename in os.listdir(test_dir):\n",
        "    source_path = os.path.join(test_dir, filename)\n",
        "    if os.path.isfile(source_path) and filename.lower().endswith(('.png', '.jpg', '.jpeg', '.gif')):\n",
        "        # Move them directly to the unknown_class_dir\n",
        "        destination_path = os.path.join(unknown_class_dir, filename)\n",
        "        shutil.move(source_path, destination_path)\n",
        "        print(f\"Moved image from {test_dir} to {unknown_class_dir}: {filename}\")\n",
        "\n",
        "# Now, move any image files that were incorrectly placed directly into test_images_subdir\n",
        "# into the 'unknown_class' subdirectory.\n",
        "images_moved_from_subdir = 0\n",
        "for filename in os.listdir(test_images_subdir):\n",
        "    source_path = os.path.join(test_images_subdir, filename)\n",
        "    # Only move actual image files, not the 'unknown_class' directory itself\n",
        "    if os.path.isfile(source_path) and filename.lower().endswith(('.png', '.jpg', '.jpeg', '.gif')):\n",
